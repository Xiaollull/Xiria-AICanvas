WEB_HOST=0.0.0.0
WEB_PORT=8717
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8718

# Relative paths are resolved from the repository root. Output may use a custom
# nested relative folder (for example outputs/my-project) or an absolute local
# directory. The preview workspace browses arbitrary nested output folders.
XIRAI_CACHE_DIR=.cache
XIRAI_OUTPUT_DIR=outputs

# Written only after environment verification and production build succeed.
# XIRAI_SETUP_MARKER=.cache/setup-complete.json

# Optional interpreter override is used only to create .venv during setup.
# Runtime always uses the verified project .venv.
# XIRAI_PYTHON=python3.12

# Automatic setup benchmarks every download item. Large files use Range
# segments while Python package groups download multiple wheels concurrently.
# XIRAI_PACKAGE_SOURCE=auto
# XIRAI_DOWNLOAD_CONNECTIONS=8
# XIRAI_PACKAGE_CONCURRENCY=12

# PyTorch auto-selection ignores any system CUDA Toolkit and previously
# installed PyTorch. It detects only the NVIDIA driver compatibility ceiling,
# then chooses the newest stable PyTorch and newest compatible bundled CUDA
# runtime wheel in one pass. It never silently falls back to CPU on an NVIDIA
# machine. Use a manual variant only for diagnostics or special policy.
# XIRAI_TORCH_VARIANT=auto
# XIRAI_TORCH_VERSION=
# XIRAI_TORCH_INDEX=https://download.pytorch.org/whl

# ComfyUI-style runtime VRAM policy. Auto compares current free VRAM with the
# checkpoint's FP16 weight size, requested canvas, inference workspace, and an
# OS reserve. Accepted overrides: high_vram, normal_vram, low_vram. Legacy
# aliases high, balanced, and conservative remain accepted.
# XIRAI_MEMORY_MODE=auto
# XIRAI_RESERVE_VRAM_GB=0.7

# uv is pinned and installed only inside the project cache. These optional
# official-installer-compatible variables select one or more artifact bases.
# The archive filename is appended automatically and SHA-256 stays mandatory.
# Setting any variable below overrides the built-in accelerated and official
# route list, which is useful for private mirrors or official-only downloads.
# UV_DOWNLOAD_URL=https://your-mirror.example/uv/releases/download/0.11.29
# INSTALLER_DOWNLOAD_URL=https://your-generic-mirror.example/uv/0.11.29
# UV_INSTALLER_GITHUB_BASE_URL=https://github.com
# UV_GITHUB_TOKEN=

# Standard proxy variables are honored during the first bootstrap download.
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Setup downloads small offline Diffusers runtime configs from Hugging Face and
# defaults this to the mirror matching the selected package source. Set it only
# when both huggingface.co and hf-mirror.com are unreachable from this machine;
# setup warns and retries later rather than failing when they are.
# HF_ENDPOINT=https://hf-mirror.com

# Optional executable override. Normally nvidia-smi is discovered from PATH;
# the CUDA Driver API is also queried as a fallback for newer output formats.
# NVIDIA_SMI_PATH=nvidia-smi

# Optional preview tuning.
PREVIEW_MAX_FRAMES=8
PREVIEW_MIN_INTERVAL=0.7
PREVIEW_MAX_EDGE=384

# ADetailer always uses this project's verified Python environment and stores
# official and community Ultralytics .pt models under models/yolo. The app can
# benchmark and download its five bundled model choices automatically.
